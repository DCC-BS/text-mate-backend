{
    // Dev container for this repo: shared DCC-BS image (mise, zsh, agent sync
    // baked in). Template + adoption steps:
    // https://github.com/DCC-BS/dcc-docker-images/tree/main/devcontainer
    "name": "text-mate-backend",
    "image": "ghcr.io/dcc-bs/dcc-docker-images/devcontainer:24.04",
    // Run as root: DevPod's workspace agent and `mise bootstrap packages apply`
    // (apt) need it. Create workspaces from the git URL so the checkout lives
    // in a DevPod-managed volume — with a local-folder workspace on rootless
    // Podman, container writes map to your subuid and pollute the host tree.
    "remoteUser": "root",
    "containerUser": "root",
    "updateRemoteUserUID": false,
    // SELinux-enforcing hosts (Fedora/RHEL): bind-mounted host files keep their
    // user_home_t label, which container_t is denied regardless of uid. Opt the
    // container out of SELinux confinement.
    "runArgs": ["--security-opt", "label=disable"],
    // Stages personal coding-agent state on the HOST (opt-in per user) and
    // mounts it read-only. The staging script lives in YOUR home, not the
    // repo — create ~/.config/devcontainer/host-sync.sh to opt in (omp users:
    // copy the example from dcc-docker-images devcontainer/README.md).
    // Without it: the staging dir is cleared and nothing personal is shared.
    "initializeCommand": "mkdir -p \"$HOME/.cache/devcontainer-agent-state\" && if [ -f \"$HOME/.config/devcontainer/host-sync.sh\" ]; then bash \"$HOME/.config/devcontainer/host-sync.sh\"; else find \"$HOME/.cache/devcontainer-agent-state\" -mindepth 1 -delete; fi",
    "mounts": [
        "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind",
        "source=${localEnv:HOME}/.cache/devcontainer-agent-state,target=/mnt/agent-state,type=bind,readonly",
        // Host podman socket (systemctl --user enable --now podman.socket):
        // `docker` and `docker compose` inside run SIBLING containers on the
        // host (vllm, docling-serve). No daemon inside the container.
        "source=${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock,target=/var/run/docker.sock,type=bind"
    ],
    "remoteEnv": {
        "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}",
        // pass-cli reads the Proton Pass key material from the filesystem
        "PROTON_PASS_KEY_PROVIDER": "fs",
        // docker-compose bind sources must be HOST-side paths (the daemon is
        // the host podman socket; ${HOME} in the container is /root, which the
        // rootless daemon may not write). localEnv resolves on the host, so
        // every workspace and host-native run share the same cache dir.
        "HF_CACHE_DIR": "${localEnv:HOME}/cache/huggingface",
        "DOCLING_CACHE_DIR": "${localEnv:HOME}/.cache/docling"
    },
    // App port only. Do NOT list the compose sidecar ports (8001 vllm,
    // 5001 docling): sibling containers publish those on the host themselves,
    // and a DevPod forward binding the same host port blocks their start
    // ("rootlessport ... address already in use").
    "forwardPorts": [8000],
    // Create-time bootstrap from the shared image: mise trust + install
    // (uv, rust, varlock, pass-cli, usage) + `mise bootstrap packages apply`
    // (no-op here: mise.toml has no [bootstrap.packages]) + GitHub host key
    // + agent sync — driven by this repo's mise.toml in the workspace root.
    // The sed drops SSH_AUTH_SOCK from DevPod's env snapshot
    // (/etc/envfile.json): DevPod writes the create-tunnel socket there and
    // its agent restores that value for the dotfiles clone in a later
    // session, where the socket is already dead — the clone then fails with
    // a silent "Permission denied (publickey)" (exit 128, breaking `devpod
    // up`). Without the key the agent inherits the live forwarded socket.
    "postCreateCommand": "bash /usr/local/bin/setup-workspace && sed -E -i 's/,?\"SSH_AUTH_SOCK\":\"[^\"]*\"//' /etc/envfile.json",
    // Re-applies staged agent state on every start (DevPod's dotfiles step runs
    // after postCreate and re-links dot_omp/config.yml over the staged copy).
    // The script is baked into the shared image; /etc/zsh/zshenv re-runs it
    // on every shell start.
    "postStartCommand": "bash /usr/local/bin/sync-agent",
    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot",
                "github.copilot-chat",
                "ms-python.python",
                "ms-python.debugpy",
                "charliermarsh.ruff"
            ]
        }
    }
}
