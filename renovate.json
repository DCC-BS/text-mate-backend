{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "dependencyDashboard": true,
  "extends": [
    "config:recommended"
  ],
  "ignoreTests": true,
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": false
  },
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ]
    },
    {
      "groupName": "all major dependencies",
      "groupSlug": "all-major",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "description": "Updates that need a human (DCC dependency routine hold_majors; 0.x minors count as major) get their own PR",
      "groupName": "held dependencies",
      "groupSlug": "held",
      "matchPackageNames": [
        "vllm/vllm-openai"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ]
    },
    {
      "description": "Python runtime bumps need wheels for every compiled dependency (spaCy stack has no cp315 wheels yet as of 2026-10-24), so they get their own PR",
      "groupName": "held dependencies",
      "groupSlug": "held",
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ]
    }
  ],
  "prConcurrentLimit": 2
}
